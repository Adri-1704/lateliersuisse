# ===========================================
# Just-Tag.ch Environment Variables
# Copy this file to .env.local and fill in your values
# ===========================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs - Standard (after 100 subscribers)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_SEMIANNUAL=price_...
STRIPE_PRICE_ANNUAL=price_...

# Stripe Price IDs - Early Bird (first 100 subscribers)
STRIPE_PRICE_MONTHLY_EARLY=price_...
STRIPE_PRICE_SEMIANNUAL_EARLY=price_...
STRIPE_PRICE_ANNUAL_EARLY=price_...

# Stripe Price IDs - Lifetime (one-time payment)
STRIPE_PRICE_LIFETIME=price_...
STRIPE_PRICE_LIFETIME_EARLY=price_...

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=Just-Tag <noreply@just-tag.ch>
ADMIN_EMAIL=admin@just-tag.ch

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp (Meta Cloud API)
# META_WEBHOOK_VERIFY_TOKEN, META_WHATSAPP_TOKEN, META_WHATSAPP_PHONE_ID,
# META_WHATSAPP_TEMPLATE_NAME sont déjà utilisés ailleurs dans le code.
# META_APP_SECRET = "App secret" de l'app Meta (Meta for Developers > Paramètres
# de l'app > Général), utilisé pour vérifier la signature HMAC-SHA256 du header
# X-Hub-Signature-256 envoyé sur les webhooks entrants (route
# /api/webhooks/whatsapp). Sans cette variable, les webhooks Meta (branche JSON)
# sont rejetés avec 401.
META_APP_SECRET=your-meta-app-secret

# Cron (protège /api/blog/publish et /api/blog/publish-next)
CRON_SECRET=your-cron-secret
